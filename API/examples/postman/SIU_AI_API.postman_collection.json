{
  "info": {
    "_postman_id": "2626128f-51fe-4866-a714-6fcb05f76e5f",
    "name": "SIU AI API",
    "description": "Starter requests for the SIU Computer Science LiteLLM gateway. Select the SIU AI environment before sending requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{api_key}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1 - List available models",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/models",
          "host": ["{{base_url}}"],
          "path": ["models"]
        },
        "description": "Run this first. Copy the Qwen 3.8 27B public model ID into the model_id environment variable."
      },
      "response": []
    },
    {
      "name": "2 - Chat completion",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response contains a choice\", function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body.choices).to.be.an(\"array\").that.is.not.empty;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"model\": \"{{model_id}}\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a careful programming tutor.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Explain what a REST API is in three sentences.\"\n    }\n  ],\n  \"temperature\": 0.2,\n  \"stream\": false\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/chat/completions",
          "host": ["{{base_url}}"],
          "path": ["chat", "completions"]
        }
      },
      "response": []
    }
  ]
}
